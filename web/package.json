{
  "name": "slotkeeper-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4195",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json index.html",
    "format:check": "prettier --check src e2e *.ts *.json index.html"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource-variable/public-sans": "5.3.0",
    "lucide-react": "1.75.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "@playwright/test": "1.65.1",
    "prettier": "3.9.10",
    "@types/node": "24.10.0",
    "@vitejs/plugin-react": "6.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vitest": "5.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "29.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
