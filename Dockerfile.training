# Deliberately separate artifact: no product jar, session database or migration credentials.
FROM eclipse-temurin:21-jre-noble@sha256:0d57a8e90c2bb844c5a8e1b2b71e11eff06dad7edcfd803cd21ed4ae203b2515
WORKDIR /opt/slotkeeper-training
COPY --chown=10001:10001 training-target/build/install/training-target/ ./
COPY --chown=10001:10001 LICENSE NOTICE /opt/slotkeeper-training/
USER 10001:10001
EXPOSE 4193
ENTRYPOINT ["/opt/slotkeeper-training/bin/training-target"]
